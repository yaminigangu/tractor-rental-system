{
  "name": "tractor-rental-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "dev:all": "concurrently -n \"FE,BE\" -c \"cyan,green\" \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "build": "npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init",
    "test:rbac": "npm --prefix backend run test:rbac",
    "test:profile": "npm --prefix backend run test:profile",
    "db:audit": "npm --prefix backend run db:audit"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
